{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist/gateway",
        "rootDir": "./gateway"
    },
    "include": [
        "gateway/**/*"
    ],
    "exclude": [
        "node_modules",
        "gateway/server.ts"
    ]
}